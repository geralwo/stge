use "test_object.stge"
Terminal::print("stge version: ${version.to_str()}\n")
test_quit = 0

player = {
    player.char = "@"
    player.pos = vec2i(0, 0)
    player.vel = vec2i(0, 0)
    player.up = Input::Key.KEY_W
    player.down = Input::Key.KEY_S
    player.left = Input::Key.KEY_A
    player.right = Input::Key.KEY_D
    player.exit = Input::Key.KEY_Q
    player.move = () {
        if Input::is_key_pressed(player.up) {
            player.pos.y -= 1
        }
        if Input::is_key_pressed(player.down) {
            player.pos.y += 1
        }
        if Input::is_key_pressed(player.left) {
            player.pos.x -= 1
        }
        if Input::is_key_pressed(player.right) {
            player.pos.x += 1
        }
        if Input::is_key_pressed(player.exit) {
            Terminal::print("Exit ${int::to_str(test_quit)}\n")
            test_quit = 6666
            Terminal::print("Exit ${int::to_str(test_quit)}\n")
        }
    }
}


while not test_quit {
    Terminal::clear()
    Input::poll()
    player.move()
    Terminal::print_at(player.pos.x, player.pos.y, player.char)
}